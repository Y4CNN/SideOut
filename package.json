{
  "name": "arbitre-volley",
  "private": true,
  "version": "1.0.0",
  "description": "PWA mobile pour l'arbitre de volley-ball (6x6) — règles FIVB 2025-2028 / FFVB",
  "type": "module",
  "scripts": {
    "images": "node scripts/images.mjs",
    "verify:mobile": "node scripts/verify.mjs",
    "audit:ui": "node scripts/audit-ui.mjs",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "immer": "^11.2.9",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lighthouse": "^13.6.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
